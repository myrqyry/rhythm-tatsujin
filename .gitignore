# ====================
# TaikoNationV1 - .gitignore
# Cleaned, organized, and deduplicated
# ====================

# ----- Python artifacts -----
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# Byte-compiled / optimized / DLL files
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# pip / build
pip-wheel-metadata/
build/
dist/
*.egg-info/
*.egg

# C extensions
*.so

# ----- Packaging / installer logs -----
pip-log.txt
pip-delete-this-directory.txt

# ----- Test / coverage -----
.tox/
.nox/
.coverage
.coverage.*
.pytest_cache/
htmlcov/
coverage.xml

# ----- Type checking caches -----
.mypy_cache/
.pyright/

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo

# ----- OS files -----
.DS_Store

# ----- Logs / runtime outputs -----
*.log
logs/
server.out
server_fastapi.out
nohup.out
uvicorn.log

# ----- Notebooks -----
.ipynb_checkpoints/

# ----- Local env files -----
.env
.env.*

# ----- Databases -----
*.sqlite3
*.db

# ----- Machine learning artifacts -----
# (Uncomment or add large model directories if you want to ignore them)
*.pth
*.pt
*.tfl
*.h5
wandb/
output/
dummy_*.npy
dummy_*.wav

# Raw local song audio is runtime/user data. The tracked research corpus uses
# precomputed .npy features, so never scoop source songs into a checkpoint.
input_songs/*.wav
input_songs/*.mp3
input_songs/*.flac
input_songs/*.ogg
input_songs/*.m4a
input_songs/*.aac

# Local human-reference beatmap archives/audio. Keep copyrighted source assets
# out of Git; taikonation-import-reference writes extracted data under output/.
reference_osz/
*.osz

# Optional (commented): large folders you may want to ignore
# /model/
# /output/
# /input_songs/
# /input_charts_nr/

# meristem:local-ignore:start
.meristem/local/
# meristem:local-ignore:end
